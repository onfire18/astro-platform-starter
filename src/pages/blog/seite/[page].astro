---
import MDLayout from '../../../layouts/MDLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const PAGE_SIZE = 24;
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );
  // Seite 1 ist /blog (Featured + erste 24); hier nur die älteren Seiten
  const rest = posts.slice(1);
  const totalPages = Math.max(1, Math.ceil(rest.length / PAGE_SIZE));
  const paths = [];
  for (let p = 2; p <= totalPages; p++) {
    paths.push({
      params: { page: String(p) },
      props: {
        posts: rest.slice((p - 1) * PAGE_SIZE, p * PAGE_SIZE),
        page: p,
        totalPages,
      },
    });
  }
  return paths;
}

type Props = {
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
  page: number;
  totalPages: number;
};
const { posts, page, totalPages } = Astro.props;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
const pageHref = (p: number) => (p === 1 ? '/blog' : `/blog/seite/${p}`);
---

<MDLayout
  title={`Blog – Seite ${page} von ${totalPages}`}
  ogImage="/images/og/blog.jpg"
  description="Praktische Ratgeber zu Website-Kosten, Webdesign für KMU, DSGVO, Barrierefreiheit und mehr Kunden über die eigene Website. Klar, ehrlich und ohne Fachchinesisch."
>
  <!-- Kompakter Hero -->
  <section class="blog-hero" aria-label="Blog">
    <div class="md-container">
      <span class="md-label">Blog · Seite {page}</span>
      <h1 class="blog-hero-h1">Wissen rund um Ihre Website</h1>
    </div>
  </section>

  <section class="md-section blog-list-section">
    <div class="md-container">
      <ul class="blog-grid" role="list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`} class="blog-card">
              <span class="blog-cat" aria-label={`Kategorie: ${post.data.category}`}>{post.data.category}</span>
              <h2 class="blog-card-title">{post.data.title}</h2>
              <p class="blog-card-desc">{post.data.description}</p>
              <div class="blog-meta">
                <span>{fmtDate(post.data.pubDate)}</span>
                {post.data.readingTime && <span>· {post.data.readingTime} Min.</span>}
              </div>
            </a>
          </li>
        ))}
      </ul>

      <nav class="blog-pagination" aria-label="Blog-Seiten">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
          <a
            href={pageHref(p)}
            class={`blog-page-link${p === page ? ' current' : ''}`}
            aria-current={p === page ? 'page' : undefined}
          >{p}</a>
        ))}
      </nav>
    </div>
  </section>
</MDLayout>

<style>
  .blog-hero {
    background:
      radial-gradient(ellipse 60% 70% at 85% 20%, rgba(20,85,168,0.16) 0%, transparent 60%),
      linear-gradient(160deg, #080C14 0%, #0C1828 60%, #0F172A 100%);
    padding-top: calc(var(--nav-h) + 3rem);
    padding-bottom: 2.5rem;
  }
  .blog-hero .md-label { color: #60A5FA; }
  .blog-hero-h1 {
    font-family: 'Outfit Variable', 'Outfit', system-ui, sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: #F1F5F9;
    line-height: 1.1;
    text-wrap: balance;
  }

  .blog-list-section { background: var(--md-bg); }

  .blog-cat {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--md-cta);
    background: var(--md-accent);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    margin-bottom: 1rem;
  }
  .blog-meta { font-size: 0.82rem; color: var(--md-subtle); display: flex; gap: 0.35rem; }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--md-surface);
    border-radius: 12px;
    padding: 1.5rem;
    border-top: 3px solid transparent;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    transition:
      box-shadow 280ms var(--ease-out),
      border-color 280ms var(--ease-out),
      transform 280ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .blog-card:hover {
      box-shadow: 0 4px 12px rgba(20, 85, 168, 0.08), 0 12px 36px rgba(20, 85, 168, 0.12);
      border-top-color: var(--md-cta);
      transform: translateY(-3px);
    }
  }
  .blog-card-title {
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--md-primary);
    margin-bottom: 0.6rem;
    text-wrap: balance;
    font-weight: 600;
  }
  .blog-card-desc { color: var(--md-muted); font-size: 0.92rem; line-height: 1.6; flex: 1; margin-bottom: 1rem; }

  @media (max-width: 1100px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .blog-grid { grid-template-columns: 1fr; } }

  .blog-pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }
  .blog-page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.75rem;
    border-radius: 8px;
    background: var(--md-surface);
    color: var(--md-secondary);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .blog-page-link:hover { background: var(--md-accent); color: var(--md-cta); }
  }
  .blog-page-link.current { background: var(--md-cta); color: #fff; }
</style>
