# Umgebungsvariablen für mediadrift.de
# Kopieren als `.env` (lokal) bzw. in den Netlify-Site-Einstellungen setzen.
# `.env` gehört NICHT ins Repository.

# Zugang zum internen Entwurf-Generator (/tools/entwurf).
# PFLICHT, sobald das Tool genutzt werden soll: Ohne diese Variable ist der
# Zugang gesperrt — es gibt bewusst keinen Standard-PIN mehr, ein im Code
# hinterlegter wäre öffentlich bekannt und damit kein Schutz.
ENTWURF_PIN=

# API-Key für die Entwurfs-Generierung. Wird nur serverseitig gelesen und
# nie an den Browser ausgeliefert.
ANTHROPIC_API_KEY=

# Optional: Datei-Uploads in den Demo-Seiten abschalten ("true"/"false").
PUBLIC_DISABLE_UPLOADS=
